# PersonalRAG 环境变量（复制为 .env 后填写）
# Windows: copy .env.example .env      macOS/Linux: cp .env.example .env

# ── LLM（OpenAI 兼容接口，DeepSeek 也用它）──────────────
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── Embedding ──────────────────────────────────────────
# local：本地模型，离线、免费（默认）；api：OpenAI 兼容 /embeddings；auto：先试 api
# EMBEDDING_PROVIDER=local
# EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
# 仅在 EMBEDDING_PROVIDER=api 时需要：
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE=

# ── 服务 ───────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8000
# MAX_UPLOAD_MB=50

# ── 检索 / 切块（一般不用改）────────────────────────────
# CHUNK_SIZE=500
# CHUNK_OVERLAP=60
# TOP_K=8
# RERANK_TOP_K=5
# BM25_WEIGHT=0.35
# ENABLE_QA_CACHE=1
# AUTO_MIGRATE=1

# 国内下载 HuggingFace 模型走镜像（默认已设置 hf-mirror.com）
# HF_ENDPOINT=https://hf-mirror.com
